# Populate these through the deployment platform's secret manager. Do not copy
# real values into this file or commit a .env file.
SPRING_PROFILES_ACTIVE=prod

MYSQL_HOST=private-db.example.internal
MYSQL_PORT=3306
MYSQL_USER=service_user
MYSQL_PASSWORD=replace-from-secret-manager
JPA_DDL_AUTO=validate
IAM_SERVICE_DATABASE=iam_db
TEST_SERVICE_DATABASE=test_db
ATTEMPT_SERVICE_DATABASE=attempt_db
ANALYTICS_SERVICE_DATABASE=analytics_db
COMMUNITY_SERVICE_DATABASE=community_db

REDIS_HOST=private-redis.example.internal
REDIS_PORT=6380
REDIS_PASSWORD=replace-from-secret-manager
REDIS_SSL_ENABLED=true

KAFKA_BOOTSTRAP_SERVERS=private-kafka.example.internal:9093
SPRING_KAFKA_BOOTSTRAP_SERVERS=private-kafka.example.internal:9093
KAFKA_SECURITY_PROTOCOL=SASL_SSL
KAFKA_SASL_MECHANISM=SCRAM-SHA-512
KAFKA_SASL_JAAS_CONFIG=replace-from-secret-manager

# Generate a distinct, high-entropy secret per service integration and rotate it.
ATTEMPT_SERVICE_SECRET=replace-from-secret-manager
COMMUNITY_SERVICE_SECRET=replace-from-secret-manager
TEST_SERVICE_SECRET=replace-from-secret-manager
IAM_SERVICE_SECRET=replace-from-secret-manager
ANALYTICS_SERVICE_SECRET=replace-from-secret-manager

# IAM receives only the PKCS#8 private key. The gateway receives only the
# matching X.509 public key. Base64 encode the DER forms; do not store keys in git.
JWT_SIGNING_ALGORITHM=RS256
JWT_PRIVATE_KEY_PATH=replace-from-secret-manager
JWT_PUBLIC_KEY_PATH=replace-from-secret-manager
JWT_ISSUER=https://auth.example.com
JWT_AUDIENCE=testing-platform-api
JWT_EXPIRATION_MS=900000
REFRESH_TOKEN_EXPIRATION_MS=2592000000

COOKIE_SECURE=true
COOKIE_SAME_SITE=Strict
COOKIE_DOMAIN=api.example.com
CORS_ALLOWED_ORIGINS=https://app.example.com
SPRINGDOC_ENABLED=false

IAM_SERVICE_URL=http://iam-service:8080/auth-api
TEST_SERVICE_URL=http://test-service:8080/tests-api
ATTEMPT_SERVICE_URL=http://attempt-service:8080/attempts-api
ANALYTICS_SERVICE_URL=http://analytics-service:8080/analytics-api
COMMUNITY_SERVICE_URL=http://community-service:8080/community-api

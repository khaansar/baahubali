```dotenv
# ============================================================
# BAAHUBALI - ROOT ENVIRONMENT TEMPLATE
# File: .env.example
#
# Copy to .env for local development.
# Replace every CHANGE_ME value before running.
# Never commit .env or production secrets.
# ============================================================


# ============================================================
# APPLICATION
# ============================================================

API_VERSION=v1
APP_NAME=clearit
CORS_ALLOWED_ORIGINS=http://localhost:3000


# ============================================================
# SERVICE URLS
# These are service origins, WITHOUT context paths.
# Adjust hostnames to match your Docker Compose service names.
# ============================================================

IAM_SERVICE_URL=http://iam-service:8080
TEST_SERVICE_URL=http://test-service:8080
ATTEMPT_SERVICE_URL=http://attempt-service:8080
COMMUNITY_SERVICE_URL=http://community-service:8080
ANALYTICS_SERVICE_URL=http://analytics-service:8080
PAYMENT_SERVICE_URL=http://payment-service:8080

# Notification Service currently has no API Gateway route
# in the configuration shown.
NOTIFICATION_SERVICE_URL=http://notification-service:8080


# ============================================================
# DATABASE - MYSQL
# Configure these for the database host used by your deployment.
# For Docker Compose, MYSQL_HOST is typically the MySQL service
# name; for an application running directly on your machine,
# use localhost.
# ============================================================

MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=CHANGE_ME_USE_A_STRONG_DATABASE_PASSWORD

IAM_SERVICE_DATABASE=iam_db
TEST_SERVICE_DATABASE=test_db
ATTEMPT_SERVICE_DATABASE=attempt_db
COMMUNITY_SERVICE_DATABASE=community_db
ANALYTICS_SERVICE_DATABASE=analytics_db
PAYMENT_SERVICE_DATABASE=payment_db
NOTIFICATION_SERVICE_DATABASE=notification_db

# Use a production-appropriate value.
# For example, validate, update, or none depending on your
# existing migration and schema-management strategy.
JPA_DDL_AUTO=validate

SPRING_FLYWAY_ENABLED=true
FLYWAY_BASELINE_ON_MIGRATE=false


# ============================================================
# REDIS
# ============================================================

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_USE_A_STRONG_REDIS_PASSWORD
REDIS_SSL_ENABLED=false


# ============================================================
# KAFKA
# Use the appropriate broker address for your Docker network.
# Keep both variable names because services currently use
# different Spring Kafka environment-variable names.
# ============================================================

KAFKA_BOOTSTRAP_SERVERS=kafka:9092
SPRING_KAFKA_BOOTSTRAP_SERVERS=kafka:9092

SPRING_KAFKA_CONSUMER_GROUP=
SPRING_KAFKA_CONSUMER_GROUP=analytics-service


# ============================================================
# INTER-SERVICE AUTHENTICATION
#
# Generate a different cryptographically random secret for
# EACH service. Do not use these placeholder strings as secrets.
#
# Every outbound HTTP request must send:
#   X-Service-Caller
#   X-Service-Auth
#
# The receiving service must validate both headers against its
# internal.auth.allowed-clients configuration.
# ============================================================

API_GATEWAY_SECRET=CHANGE_ME_UNIQUE_GATEWAY_SECRET
IAM_SERVICE_SECRET=CHANGE_ME_UNIQUE_IAM_SECRET
TEST_SERVICE_SECRET=CHANGE_ME_UNIQUE_TEST_SECRET
ATTEMPT_SERVICE_SECRET=CHANGE_ME_UNIQUE_ATTEMPT_SECRET
COMMUNITY_SERVICE_SECRET=CHANGE_ME_UNIQUE_COMMUNITY_SECRET
ANALYTICS_SERVICE_SECRET=CHANGE_ME_UNIQUE_ANALYTICS_SECRET
PAYMENT_SERVICE_SECRET=CHANGE_ME_UNIQUE_PAYMENT_SECRET
NOTIFICATION_SERVICE_SECRET=CHANGE_ME_UNIQUE_NOTIFICATION_SECRET


# ============================================================
# JWT - GATEWAY AND IAM
# ============================================================

JWT_SIGNING_ALGORITHM=RS256
JWT_SECRET=
JWT_PRIVATE_KEY_PATH=/run/secrets/jwt-private-key.pem
JWT_PUBLIC_KEY_PATH=/run/secrets/jwt-public-key.pem

JWT_ISSUER=https://issuer.example.com
JWT_AUDIENCE=baahubali-api
JWT_EXPIRATION_MS=900000
REFRESH_TOKEN_EXPIRATION_MS=604800000

# Enable API documentation only when appropriate.
SPRINGDOC_ENABLED=false


# ============================================================
# OAUTH - GOOGLE
# ============================================================

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/auth-api/login/oauth2/code/google

OAUTH_SESSION_COOKIE_SECURE=false
OAUTH_SESSION_COOKIE_SAME_SITE=Lax


# ============================================================
# AUTHENTICATION EMAILS AND PASSWORD RESET
# Set these to the actual frontend routes in your application.
# ============================================================

EMAIL_VERIFICATION_BASE_URL=http://localhost:3000/verify-email
PASSWORD_RESET_BASE_URL=http://localhost:3000/reset-password

COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax


# ============================================================
# EMAIL / SMTP - NOTIFICATION SERVICE
# ============================================================

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
MAIL_SMTP_CONNECTION_TIMEOUT=10000
MAIL_SMTP_TIMEOUT=10000
MAIL_SMTP_WRITE_TIMEOUT=10000

NOTIFICATION_MAX_ATTEMPTS=5
NOTIFICATION_RETRY_DELAY_SECONDS=30


# ============================================================
# PAYMENT SERVICE
# ============================================================

PAYMENT_ORDER_TTL_MINUTES=30

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=


# ============================================================
# OPTIONAL SERVICE CONFIGURATION
# ============================================================

# Add other variables required by your existing Compose files,
# application.yml files, and services here.
```
